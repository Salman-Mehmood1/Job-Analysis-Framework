# Port the API (and built UI) listens on
PORT=3001
# Required in production: secret used to sign session cookies
JWT_SECRET=change-me
# SQLite database file
DB_FILE=data/job-evaluation.db
# Set to false to skip creating the demo organisation on first start
SEED_DEMO=true
# Optional: enables AI job-description analysis with Claude (rule-based analyser otherwise)
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the JD analyser
JD_MODEL=claude-opus-5-5
